---
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import olympians from "../../data/olympians.json";
---

<Layout title="Les femmes des JO" description="Les femmes des JO.">
  <h1>Les femmes des JO</h1>
  <p class="pb-10">
    Les performances sont globalement identiques.
    <br />On peut lire ici quels sports ont le plus de médailles d'or.
  </p>
  <section id="femmes">
    <PlotFigure
      options={{
        marginLeft: 100,
        marks: [
          Plot.dot(
            olympians.filter((olympians) => olympians.sex === "female"),
            { x: "gold", y: "sport", stroke: "indigo" },
          ),
        ],
      }}
    />
  </section>
</Layout>
