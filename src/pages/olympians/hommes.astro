---
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import olympians from "../../data/olympians.json";
---

<Layout title="Les hommes des JO" description="Les hommes des JO.">
  <h1>Les hommes des JO</h1>
  <p class="pb-10">
    Les performances sont globalement équivalentes à celles des femmes.
    <br />On peut lire ici quels sports ont le plus de médailles d'or.
  </p>
  <section id="hommes">
    <PlotFigure
      options={{
        marginLeft: 100,
        marks: [
          Plot.dot(
            olympians.filter((olympians) => olympians.sex === "male"),
            { x: "gold", y: "sport", stroke: "indigo" },
          ),
        ],
      }}
    />
  </section>
</Layout>
