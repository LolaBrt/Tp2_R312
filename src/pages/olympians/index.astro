---
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import olympians from "../../data/olympians.json";
---

<Layout title="Les JO" description="Vue d'ensemble">
  <h1>Les pizzas</h1>

  <nav class="menu text-indigo-300" aria-label="Choisir un paramètre">
    <a href="#revenus">Les hommes</a>
    <a href="#commande">Les femmes</a>
  </nav>

  <div class="slider">
    <section id="revenus" class="slide">
      <h2>Les hommes</h2>
      <PlotFigure
        options={{
          marginLeft: 100,
          marks: [
            Plot.dot(
              olympians.filter((olympians) => olympians.sex === "male"),
              { x: "gold", y: "sport", stroke: "indigo" },
            ),
          ],
        }}
      />
      <a
        class="my-2 rounded-lg inline-block bg-indigo-300 px-2 py-2 text-indigo hover:text-orange-100"
        href="/pizzas/revenus">Voir plus</a
      >
    </section>

    <section id="commande" class="slide">
      <h2>Les femmes</h2>
      <PlotFigure
        options={{
          marginLeft: 100,
          marks: [
            Plot.dot(
              olympians.filter((olympians) => olympians.sex === "female"),
              { x: "gold", y: "sport", stroke: "indigo" },
            ),
          ],
        }}
      />
      <a
        class="my-2 rounded-lg inline-block bg-indigo-300 px-2 py-2 text-indigo hover:text-orange-100"
        href="/pizzas/commande">Voir plus</a
      >
    </section>
  </div>
</Layout>
