---
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import penguins from "../../data/penguins.json";
---

<Layout
  title="Les manchots à jugulaire"
  description="Les manchots à jugulaire selon leur sexe."
>
  <h1>Les manchots à jugulaire</h1>
  <p class="pb-10">
    Voici la différence de taille des nageoires des manchots à jugulaire selon
    leur sexe.
    <br />La différence est subtile mais les mâles ont tendance plus
    conséquentes.
  </p>
  <section id="chinstrap">
    <PlotFigure
        options={{
        color: {
            legend: true,
            domain: ["MALE", "FEMALE"],
            range: ["purple", "orange"],
        },
        marks: [
            Plot.dot(
            penguins.filter((penguin) => penguin.species === "Chinstrap"),
            { x: "culmen_length_mm", y: "culmen_depth_mm", stroke: "sex" },
            ),
        ],
        }}
    />
  </section>
</Layout>
