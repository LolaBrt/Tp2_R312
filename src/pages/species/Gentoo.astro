---
import Layout from "../../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import PlotFigure from "../../components/PlotFigure.astro";
import penguins from "../../data/penguins.json";
---

<Layout
  title="Les manchots papou"
  description="Les manchots papou selon leur sexe."
>
  <h1>Les manchots papou</h1>
  <p>
    Voici la différence de taille des nageoires des manchots papou selon
    leur sexe.
    <br />La différence est un peu plus marquée, les femelles ont tendance à en avoir de plus grosses.
  </p>
  <h3>Manchots mâles</h3>
  <PlotFigure
    options={{
      marks: [
        Plot.dot(
          penguins.filter(
            (penguin) =>
              penguin.species === "Gentoo" && penguin.sex === "MALE",
          ),
          { x: "culmen_length_mm", y: "culmen_depth_mm", stroke: "purple" },
        ),
      ],
    }}
  />
  <h3>Manchots femelles</h3>
  <PlotFigure
    options={{
      marks: [
        Plot.dot(
          penguins.filter(
            (penguin) =>
              penguin.species === "Gentoo" && penguin.sex === "FEMALE",
          ),
          { x: "culmen_length_mm", y: "culmen_depth_mm", stroke: "orange" },
        ),
      ],
    }}
  />
</Layout>
